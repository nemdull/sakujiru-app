<section class="space-y-6">
  <div class="surface-card px-6 py-5">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-neutral">作字ギャラリー</h1>
        <p class="text-sm text-slate-500">作品を検索してお気に入りのクリエイターを見つけましょう。</p>
      </div>
      <div class="md:w-80">
        <%= search_form_for @q, url: search_posts_path, html: { class: "flex gap-3" } do |f| %>
          <%= f.search_field :art_text_cont, class: "input input-bordered w-full", placeholder: "作品名・キーワードで検索" %>
          <%= f.submit '検索', class: "btn-modern" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
    <% @posts.each do |post| %>
      <%= render partial: "posts/card", locals: { post: post } %>
    <% end %>
  </div>

  <div class="flex justify-center pt-4">
    <%= paginate @posts %>
  </div>
</section>
