<section class="space-y-6">
  <header class="flex flex-col gap-2 text-center sm:text-left">
    <h1 class="text-3xl font-semibold text-neutral">検索結果</h1>
    <p class="text-sm text-slate-500"><%= @results.size %> 件ヒットしました。</p>
  </header>

  <% if @results.present? %>
    <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
      <% @results.each do |post| %>
        <%= render partial: "posts/card", locals: { post: post } %>
      <% end %>
    </div>
    <div class="flex justify-center pt-4">
      <%= paginate @results %>
    </div>
  <% else %>
    <div class="surface-card px-6 py-8 text-center text-sm text-slate-500">
      条件に一致する作品は見つかりませんでした。
    </div>
  <% end %>
</section>
