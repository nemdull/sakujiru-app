<section class="mx-auto w-full max-w-lg space-y-6">
  <div class="space-y-2 text-center">
    <h1 class="text-3xl font-semibold text-neutral">ログイン</h1>
    <p class="text-sm text-slate-500">登録済みのメールアドレスとパスワードでログインしてください。</p>
  </div>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_with scope: resource, as: resource_name, url: session_path(resource_name), local: true, html: { class: "surface-card space-y-4 px-6 py-6" } do |f| %>
    <div class="space-y-1">
      <label class="text-sm font-medium text-neutral" for="user_email">メールアドレス</label>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-bordered w-full", placeholder: "you@example.com" %>
    </div>

    <div class="space-y-1">
      <label class="text-sm font-medium text-neutral" for="user_password">パスワード</label>
      <%= f.password_field :password, autocomplete: "current-password", class: "input input-bordered w-full" %>
    </div>

    <div class="flex justify-end">
      <%= f.submit "ログイン", class: "btn-modern" %>
    </div>

    <div class="pt-2">
      <%= render "devise/shared/links" %>
    </div>
  <% end %>
</section>
