<section class="mx-auto w-full max-w-lg space-y-6">
  <div class="space-y-2 text-center">
    <h1 class="text-3xl font-semibold text-neutral">アカウントを作成</h1>
    <p class="text-sm text-slate-500">Sakujiru で作品を発信するために必要な情報を入力してください。</p>
  </div>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_with scope: resource, as: resource_name, url: registration_path(resource_name), local: true, html: { class: "surface-card space-y-4 px-6 py-6" } do |f| %>
    <div class="space-y-1">
      <label class="text-sm font-medium text-neutral" for="user_name">名前</label>
      <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "input input-bordered w-full", placeholder: "例) 山田 太郎" %>
    </div>

    <div class="space-y-1">
      <label class="text-sm font-medium text-neutral" for="user_email">メールアドレス</label>
      <%= f.email_field :email, autocomplete: "email", class: "input input-bordered w-full", placeholder: "you@example.com" %>
    </div>

    <div class="space-y-1">
      <label class="text-sm font-medium text-neutral" for="user_password">パスワード</label>
      <%= f.password_field :password, autocomplete: "new-password", class: "input input-bordered w-full", placeholder: "8文字以上で入力してください" %>
    </div>

    <div class="space-y-1">
      <label class="text-sm font-medium text-neutral" for="user_password_confirmation">パスワードを確認</label>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-bordered w-full" %>
    </div>

    <div class="flex justify-end">
      <%= f.submit "サインアップ", class: "btn-modern" %>
    </div>

    <div class="pt-2">
      <%= render "devise/shared/links" %>
    </div>
  <% end %>
</section>
