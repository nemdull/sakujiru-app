<!DOCTYPE html>
<html lang="ja" data-theme="modern">
  <head>
    <title>Sakujiru</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://js.pay.jp/v2/pay.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload', defer: true %>
  </head>

  <body class="min-h-screen flex flex-col bg-base-100 text-surface-foreground">
    <% unless current_page?(root_path) || current_page?(new_user_session_path) || current_page?(new_user_registration_path) %>
      <%= render "partial/header" %>
    <% end %>

    <main class="flex-grow">
      <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-10 space-y-6">
        <% if flash[:notice] %>
          <div class="alert alert-info shadow-sm border border-info/20 bg-info/10 text-info-content">
            <span class="font-medium"><%= flash[:notice] %></span>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="alert alert-error shadow-sm border border-error/20 bg-error/10 text-error-content">
            <span class="font-medium"><%= flash[:alert] %></span>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </main>

    <%= render "partial/footer" %>
  </body>
</html>
