<% mine = defined?(current_user) && chat_message.user_id == current_user&.id %>
<div class="flex <%= mine ? 'justify-end' : 'justify-start' %>">
  <div class="<%= mine ? 'bg-primary text-white' : 'bg-surface-subtle text-slate-700' %> max-w-xs rounded-2xl px-4 py-2 text-sm shadow-sm">
    <p class="whitespace-pre-line"><%= chat_message.content %></p>
  </div>
</div>
