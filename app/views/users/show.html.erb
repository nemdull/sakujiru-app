<section class="space-y-8">
  <div class="surface-card flex flex-col gap-6 px-6 py-8 md:flex-row md:items-center">
    <div class="avatar">
      <div class="h-24 w-24 rounded-full border border-surface-subtle bg-base-200">
        <% if @user.profile_image&.url.present? %>
          <%= image_tag @user.profile_image.url, class: "h-full w-full rounded-full object-cover" %>
        <% else %>
          <%= user_avatar(@user.name, size: 96) %>
        <% end %>
      </div>
    </div>
    <div class="flex-1 space-y-4">
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
          <h1 class="text-3xl font-semibold text-neutral"><%= @user.name %></h1>
          <p class="text-sm text-slate-400"><%= @user.email %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <% if @user == current_user %>
            <%= button_to "プロフィール編集", edit_user_registration_path, method: :get, class: "btn btn-sm border-surface-subtle text-slate-600 hover:border-primary/60 hover:bg-primary/10" %>
          <% else %>
            <%= button_to "メッセージを送る", chat_rooms_path(params: { user_id: @user.id }), method: :post, class: "btn btn-sm btn-outline border-primary/60 text-primary hover:bg-primary/10" %>
          <% end %>
        </div>
      </div>
      <p class="text-sm leading-relaxed text-slate-600"><%= @user.self_introduction.presence || "自己紹介はまだありません。" %></p>
    </div>
  </div>

  <div class="space-y-4">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-2xl font-semibold text-neutral">投稿作品</h2>
      <p class="text-sm text-slate-500"><%= @posts.size %> 件の作字を公開しています。</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
      <% @posts.each do |post| %>
        <%= render partial: "posts/card", locals: { post: post } %>
      <% end %>
    </div>
  </div>
</section>
