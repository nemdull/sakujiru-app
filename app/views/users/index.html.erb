<section class="space-y-6">
  <header class="flex flex-col gap-2 text-center sm:text-left">
    <h1 class="text-3xl font-semibold text-neutral">クリエイター一覧</h1>
    <p class="text-sm text-slate-500">気になるクリエイターをフォローし、DM で直接コミュニケーションを取りましょう。</p>
  </header>

  <div class="grid gap-6 sm:grid-cols-2">
    <% @users.each do |user| %>
      <article class="surface-card flex flex-col gap-4 px-6 py-5 sm:flex-row sm:items-center">
        <div class="avatar">
          <div class="h-16 w-16 rounded-full border border-surface-subtle bg-base-200">
            <% if user.profile_image&.url.present? %>
              <%= image_tag user.profile_image.url, class: "h-full w-full rounded-full object-cover" %>
            <% else %>
              <%= user_avatar(user.name, size: 96) %>
            <% end %>
          </div>
        </div>
        <div class="flex flex-1 flex-col gap-3">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="text-lg font-semibold text-neutral"><%= user.name %></h2>
            <div class="flex flex-wrap gap-2">
              <%= button_to "メッセージ", chat_rooms_path(params: { user_id: user.id }), method: :post, class: "btn btn-sm btn-outline border-primary/60 text-primary hover:bg-primary/10", form: { class: "inline-block" } %>
              <%= link_to "プロフィール", user_path(user), class: "btn btn-sm border-surface-subtle text-slate-600 hover:border-primary/60 hover:bg-primary/10" %>
            </div>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed">
            <%= user.self_introduction.presence || "プロフィールが未設定です。" %>
          </p>
        </div>
      </article>
    <% end %>
  </div>
</section>
